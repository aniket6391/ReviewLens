# ==========================================
# ReviewLens Environment Configuration
# ==========================================

# Choose ONE of the following free LLM API providers:

# 1. Groq (Recommended - Ultra fast free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Optional Groq Model (defaults to llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Free tier available: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini Model (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenRouter (Free models available: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Generic OpenAI Compatible Endpoint (Optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Processing Configuration
BATCH_SIZE=5
MAX_RETRIES=2
CACHE_STORAGE_TYPE=sqlite # or json
